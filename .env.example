DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=dev"
NEXT_PUBLIC_SITE_URL="https://primestreet.uk"
# NEXT_PUBLIC_GA_ID=
# Admin panel login (required in production; use a long random password)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# 32+ random chars used to sign admin session cookies
SESSION_SECRET=""
# Transactional email (review confirmation etc.). Without these, emails are only recorded in Admin > Outbox.
RESEND_API_KEY=""
# Email. MAIL_DOMAIN turns on the per-purpose senders (accounts@, editorial@, enquiries@, reviews@,
# claims@, digest@, billing@, alerts@, hello@). Only hello@ needs to be a real inbox; the rest are
# send-only and their mail says so. MAIL_SUPPORT is the address readers are told to write to instead.
MAIL_DOMAIN=""
MAIL_SUPPORT=""
# Optional per-sender override, e.g. MAIL_FROM_ACCOUNTS="PrimeStreet <login@example.com>"
# Legacy single-sender fallback, used only when MAIL_DOMAIN is unset:
MAIL_FROM=""
# Search engine verification meta tags (from Google Search Console / Bing Webmaster Tools)
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""

# Supabase / production Postgres (see docs). Percent-encode special characters in the password (@ → %40).
SUPABASE_URL=""
SUPABASE_DB_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
DIRECT_URL=""

# Encrypts the few fields that would hurt someone if they leaked (writer bank details, UTR).
# 32 bytes: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`.
# Without it, those fields cannot be saved at all — they are never stored in plain text as a fallback.
FIELD_KEY=""
# Set only while rotating: the previous key, tried on decrypt. Re-save affected rows, then remove it.
FIELD_KEY_OLD=""

# Lets the daily job at /api/cron run. 32+ characters. Without it the route answers 404 to everyone.
CRON_SECRET=""
