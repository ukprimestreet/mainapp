generator client {
  provider = "prisma-client-js"
}

// Supabase Postgres. DATABASE_URL = runtime connection, DIRECT_URL = migrations/db push.
// Enums are stored as strings and validated in src/lib/constants.ts so the schema is portable.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model City {
  id               String       @id @default(cuid())
  slug             String       @unique // "london"
  name             String
  active           Boolean      @default(true)
  status           String       @default("LIVE") // LIVE | COMING_SOON (coming soon pages are never indexed)
  intro            String? // original editorial intro; required before the city hub may be indexed
  region           String? // "Greater London"
  country          String       @default("United Kingdom")
  timezone         String       @default("Europe/London")
  lat              Float? // city centre, for "near me" when we have no postcode
  lng              Float?
  postcodePrefixes String? // JSON array of outward-code prefixes, e.g. ["E","EC","SW"] — used to detect a visitor's city
  launchedAt       DateTime?
  sortOrder        Int          @default(0)
  locations        Location[]
  businesses       Business[]
  articles         Article[]
  team             CityEditor[]
}

// Who covers a city editorially. Shown on city hubs so readers know who is behind the coverage.
model CityEditor {
  cityId    String
  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  authorId  String
  author    Author   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  role      String   @default("REPORTER") // EDITOR | REPORTER | CONTRIBUTOR
  createdAt DateTime @default(now())

  @@id([cityId, authorId])
}

model Location {
  id         String     @id @default(cuid())
  lat        Float? // area centroid (approximate) for 'near me'
  lng        Float?
  slug       String // unique WITHIN a city: two cities may both have a "richmond"
  name       String
  kind       String     @default("BOROUGH") // BOROUGH | NEIGHBOURHOOD
  intro      String? // original editorial intro; required for indexing (see seo rules)
  cityId     String
  city       City       @relation(fields: [cityId], references: [id])
  parentId   String?
  parent     Location?  @relation("LocationTree", fields: [parentId], references: [id])
  children   Location[] @relation("LocationTree")
  businesses Business[]
  articles   Article[]

  @@unique([cityId, slug])
  @@index([slug])
}

model Category {
  id            String             @id @default(cuid())
  slug          String             @unique
  name          String
  intro         String?
  parentId      String?
  parent        Category?          @relation("CategoryTree", fields: [parentId], references: [id])
  children      Category[]         @relation("CategoryTree")
  businesses    Business[]
  aliases       CategoryAlias[]
  businessLinks BusinessCategory[]
}

model Business {
  id               String                 @id @default(cuid())
  slug             String                 @unique
  name             String
  summary          String // one-line
  description      String // original text only — never copied from other directories
  cityId           String
  city             City                   @relation(fields: [cityId], references: [id])
  locationId       String
  location         Location               @relation(fields: [locationId], references: [id])
  /// The new geography. Populated alongside locationId during migration; not yet read anywhere.
  placeId          String?
  place            Place?                 @relation(fields: [placeId], references: [id])
  categoryId       String
  category         Category               @relation(fields: [categoryId], references: [id])
  areasServed      String? // comma separated location slugs / free text
  address          String?
  postcode         String?
  phone            String?
  website          String?
  email            String? // never rendered publicly
  instagram        String?
  facebook         String?
  linkedin         String?
  openingHours     String? // JSON: {mon:"09:00-17:00",...}
  services         String? // JSON string[]
  founded          Int?
  imageUrl         String?
  // trust & status
  claimStatus      String                 @default("UNCLAIMED") // UNCLAIMED | PENDING | CLAIMED | VERIFIED
  isSample         Boolean                @default(false) // demo data — shown with visible marker
  isFeatured       Boolean                @default(false) // editorial feature (not paid)
  normName         String                 @default("") // normalised name for dedupe
  websiteHost      String? // normalised host for dedupe
  source           String? // provenance: where the facts came from (owner, own research, Companies House...)
  lat              Float?
  lng              Float?
  geoSource        String? // POSTCODE | AREA | MANUAL
  gallery          String? // JSON string[] of https image URLs (Premium)
  promoText        String? // short offer/announcement shown on the profile (Premium)
  promoUrl         String?
  ownerUpdatedAt   DateTime? // last time a verified owner edited the profile
  ratingAvg        Float? // denormalised from PUBLISHED reviews only
  ratingCount      Int                    @default(0)
  ownedByFounder   Boolean                @default(false) // editorial integrity: forces disclosure on coverage
  published        Boolean                @default(true)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  articles         ArticleBusiness[]
  claims           ClaimRequest[]
  reviews          Review[]
  episodes         PodcastEpisode[]
  owners           BusinessOwner[]
  editLogs         BusinessEditLog[]
  changeRequests   ProfileChangeRequest[]
  coverageRequests CoverageRequest[]
  stats            BusinessStat[]
  subscriptions    Subscription[]
  orders           Order[]
  leads            Lead[]
  campaigns        Campaign[]
  teamInvites      TeamInvite[]
  specialHours     SpecialHours[]
  serviceAreas     BusinessServiceArea[]
  categories       BusinessCategory[]
  creditAccount    CreditAccount?

  @@index([locationId])
  @@index([categoryId])
}

model Author {
  id              String             @id @default(cuid())
  slug            String             @unique
  name            String
  role            String? // job title shown under the name
  bio             String?
  email           String?            @unique // the author's own account: identity + passwordless sign-in
  imageUrl        String? // portrait shown on the profile and as a byline avatar
  // Social links. Each is optional and its icon only appears when a link is present.
  website         String?
  x               String?
  facebook        String?
  instagram       String?
  linkedin        String?
  youtube         String?
  tiktok          String?
  threads         String?
  bluesky         String?
  mastodon        String?
  // Profile completeness gate: an author cannot submit work until these are filled in (see lib/author-profile.ts).
  phone           String?
  basedIn         String? // the London area or city they work from
  experience      String? // previous writing or professional experience
  cvUrl           String? // uploaded CV (PDF or document)
  expertise       String? // JSON string[] of the subjects they cover
  portfolio       String? // JSON string[] of links to published work elsewhere
  // How we pay them. The bank details and UTR are encrypted at rest (lib/secretbox.ts); the key lives in
  // FIELD_KEY, never in this database. bankLast4 is deliberately plain text so an admin can confirm an
  // account against a remittance without anything being decrypted.
  payeeName       String? // who the money is paid to, which is not always their byline
  payeeAddress    String? // needed on an invoice, and by us for our own records
  vatRegistered   Boolean            @default(false)
  vatNumber       String?
  utrEnc          String? // self-assessment reference, encrypted
  bankEnc         String? // { accountName, sortCode, accountNumber, iban?, swift? }, encrypted
  bankLast4       String?
  bankUpdatedAt   DateTime?
  // Account state
  active          Boolean            @default(true)
  passwordHash    String? // set by the author from the invitation link; null until then
  invitedAt       DateTime?
  invitedBy       String? // the admin who registered them
  acceptedTermsAt DateTime?
  welcomedAt      DateTime? // the welcome email has gone out
  lastLoginAt     DateTime?
  emailVerifiedAt DateTime?
  sessionVersion  Int                @default(1) // bump to sign the author out everywhere
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @default(now()) @updatedAt
  articles        Article[]
  cities          CityEditor[]
  loginTokens     AuthorLoginToken[]
  commissions     Commission[]
  payments        WriterPayment[]
}

// Single-use emailed sign-in link for an author (same pattern as business owners: no passwords stored).
model AuthorLoginToken {
  id        String    @id @default(cuid())
  authorId  String
  author    Author    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  purpose   String    @default("LOGIN") // INVITE | RESET | LOGIN
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([authorId])
}

// An admin's decision on a submitted article, with the feedback the author reads.
model ArticleReview {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  decision  String // APPROVED | CHANGES_REQUESTED
  note      String // always required: an author never gets a verdict without a reason
  reviewer  String // admin email
  createdAt DateTime @default(now())

  @@index([articleId])
}

model Article {
  id             String            @id @default(cuid())
  slug           String            @unique
  type           String // NEWS | STORY | INTERVIEW | GUIDE | BOTW | INSIGHT
  disclosure     String            @default("EDITORIAL") // EDITORIAL | SPONSORED | PARTNER | ADVERTORIAL
  title          String
  standfirst     String
  body           String // markdown-lite: the canonical TEXT of the piece. When `blocks` is set this is derived from it,
  // so search, reading time and the link audit keep working the same way for both kinds of article.
  blocks         String? // JSON block document from the visual editor; null for pieces written as plain markdown
  imageUrl       String?
  imageAlt       String?
  imageCredit    String?
  sponsorName    String? // required when disclosure is not EDITORIAL
  status         String            @default("DRAFT") // DRAFT | SUBMITTED | PUBLISHED (SUBMITTED = author sent it for review)
  submittedAt    DateTime? // when the author asked for review
  isSample       Boolean           @default(false)
  featured       Boolean           @default(false)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  authorId       String
  author         Author            @relation(fields: [authorId], references: [id])
  reviews        ArticleReview[]
  cityId         String?
  city           City?             @relation(fields: [cityId], references: [id])
  locationId     String?
  location       Location?         @relation(fields: [locationId], references: [id])
  businesses     ArticleBusiness[]
  episode        PodcastEpisode?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  corrections    Correction[]
  stats          ArticleStat[]

  @@index([type, status, publishedAt])
}

model ArticleBusiness {
  articleId  String
  businessId String
  article    Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([articleId, businessId])
}

// One interview -> episode + written article + business link + quotes/clips (content reuse).
model PodcastEpisode {
  id          String        @id @default(cuid())
  slug        String        @unique
  number      Int
  season      Int?
  episodeType String        @default("full") // full | trailer | bonus
  title       String
  description String // plain text: RSS summary, meta description
  showNotes   String? // markdown-lite
  transcript  String? // markdown-lite, "**Speaker:** text" paragraphs
  chapters    String? // JSON [{ t: seconds, title }]
  audioUrl    String? // externally hosted (https)
  audioBytes  Int? // required by Apple/Spotify enclosure
  audioMime   String        @default("audio/mpeg")
  videoUrl    String? // YouTube / Vimeo / direct mp4
  imageUrl    String?
  durationSec Int?
  explicit    Boolean       @default(false)
  guestName   String?
  guestRole   String?
  isSample    Boolean       @default(false)
  status      String        @default("DRAFT") // DRAFT | PUBLISHED (future publishedAt = scheduled)
  publishedAt DateTime?
  articleId   String?       @unique
  article     Article?      @relation(fields: [articleId], references: [id])
  businessId  String?
  business    Business?     @relation(fields: [businessId], references: [id])
  clips       EpisodeClip[]
  stats       EpisodeStat[]
  plays       EpisodePlay[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt

  @@index([status, publishedAt])
}

// Pull quotes (rendered as shareable brand cards) and clip requests (timestamps to cut for social/video).
model EpisodeClip {
  id        String         @id @default(cuid())
  episodeId String
  episode   PodcastEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  kind      String // QUOTE | CLIP
  title     String?
  quote     String? // QUOTE: the words
  speaker   String?
  startSec  Int?
  endSec    Int?
  note      String?
  status    String         @default("TODO") // CLIP: TODO | DONE
  url       String? // CLIP: link to the produced clip
  createdAt DateTime       @default(now())
}

model EpisodeStat {
  episodeId String
  day       String
  views     Int            @default(0)
  episode   PodcastEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@id([episodeId, day])
}

// One row per (episode, anonymous listener, day): deduplicated play counts. key = sha256(secret|ip|episode|day).
model EpisodePlay {
  id        String         @id @default(cuid())
  episodeId String
  episode   PodcastEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  day       String
  key       String         @unique
}

// Show-level settings (single row, id "main").
model PodcastShow {
  id          String  @id @default("main")
  title       String  @default("The PrimeStreet Podcast")
  description String  @default("Conversations with the founders and operators shaping London business.")
  author      String  @default("PrimeStreet")
  ownerEmail  String  @default("")
  imageUrl    String?
  language    String  @default("en-gb")
  category    String  @default("Business")
  explicit    Boolean @default(false)
  copyright   String  @default("")
  spotifyUrl  String?
  appleUrl    String?
  youtubeUrl  String?
}

// Claim + dispute requests. Verification evidence accumulates on the request; an admin makes the final decision.
model ClaimRequest {
  id              String    @id @default(cuid())
  kind            String    @default("CLAIM") // CLAIM | DISPUTE (someone says the current owner is wrong)
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id])
  name            String
  email           String
  phone           String
  role            String
  relationship    String
  verification    String // claimant's evidence; replies to "more info" requests are appended
  status          String    @default("PENDING") // PENDING | NEEDS_INFO | APPROVED | REJECTED | WITHDRAWN
  adminNotes      String?
  tokenHash       String    @default("") // sha256 of the emailed status/confirm token
  emailVerifiedAt DateTime?
  domainMatch     Boolean   @default(false) // claimant email domain == business website domain
  phoneCodeHash   String? // admin reads a code to the business's LISTED number; claimant enters it
  phoneCodeSetAt  DateTime?
  phoneAttempts   Int       @default(0)
  phoneVerifiedAt DateTime?
  decidedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([businessId, email])
  @@index([tokenHash])
}

// Owner accounts are passwordless (emailed sign-in link). One person can own several businesses.
model Owner {
  id              String            @id @default(cuid())
  email           String            @unique
  name            String
  sessionVersion  Int               @default(0) // bump to sign out every device
  createdAt       DateTime          @default(now())
  lastLoginAt     DateTime?
  // Marketing consent is separate from the account. Service emails (sign-in, claims, enquiries, receipts) always
  // send; anything promotional needs marketingOptIn and stops the moment unsubscribedAt is set. Under PECR a sole
  // trader or partnership counts as an individual, so we ask rather than assume.
  marketingOptIn  Boolean           @default(false)
  unsubscribedAt  DateTime?
  lastMarketingAt DateTime? // frequency cap: no more than one promotional email a fortnight
  unsubToken      String?           @unique // one-click unsubscribe without signing in
  businesses      BusinessOwner[]
  loginTokens     OwnerLoginToken[]
}

model BusinessOwner {
  ownerId    String
  businessId String
  role       String   @default("OWNER") // OWNER | MANAGER
  claimId    String? // the approved claim that granted access
  grantedAt  DateTime @default(now())
  owner      Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([ownerId, businessId])
}

model OwnerLoginToken {
  id        String    @id @default(cuid())
  ownerId   String
  owner     Owner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  ipHash    String    @default("")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Owner edits go live immediately but are logged field-by-field so an admin can revert.
model BusinessEditLog {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  ownerId    String
  changes    String // JSON { field: { from, to } }
  revertedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([businessId])
}

// Name / category / area changes need a human.
model ProfileChangeRequest {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  ownerId    String
  message    String
  status     String   @default("OPEN") // OPEN | DONE | DECLINED
  adminNote  String?
  createdAt  DateTime @default(now())
}

// "Tell us your story". Never paid, never guaranteed.
model CoverageRequest {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  ownerId    String
  topic      String
  details    String
  status     String   @default("NEW") // NEW | CONSIDERING | COMMISSIONED | DECLINED
  adminNote  String?
  createdAt  DateTime @default(now())
}

model BusinessStat {
  businessId String
  day        String // YYYY-MM-DD
  views      Int      @default(0)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([businessId, day])
}

// Reviews. Nothing is public until an admin publishes it. Lifecycle:
// UNVERIFIED (email not confirmed) -> PENDING (awaiting moderation) -> PUBLISHED | REJECTED; PUBLISHED -> HELD (hidden after reports) -> PUBLISHED
model Review {
  id              String         @id @default(cuid())
  businessId      String
  business        Business       @relation(fields: [businessId], references: [id])
  authorName      String
  authorEmail     String         @default("") // personal data: never displayed; used for verification + decisions
  authorEmailHash String // sha256(lowercased email) for duplicate detection
  rating          Int
  title           String?
  body            String
  status          String         @default("UNVERIFIED")
  flags           String? // comma-separated anti-abuse signals shown to moderators
  ipHash          String         @default("")
  bodyHash        String         @default("")
  tokenHash       String         @default("") // sha256 of the emailed manage/verify token
  emailVerifiedAt DateTime?
  response        String? // business response (public)
  respondedAt     DateTime?
  moderationNote  String?
  moderatedAt     DateTime?
  editedAt        DateTime?
  createdAt       DateTime       @default(now())
  reports         ReviewReport[]

  @@unique([businessId, authorEmailHash])
  @@index([businessId, status])
  @@index([status])
  @@index([tokenHash])
}

model ReviewReport {
  id           String   @id @default(cuid())
  reviewId     String
  review       Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reason       String // SPAM | FAKE | ABUSIVE | PERSONAL_INFO | CONFLICT | OTHER
  details      String?
  reporterKey  String // hash(ip + email) so one person counts once
  reporterType String   @default("USER") // USER | BUSINESS (self-declared, unverified until Phase 5)
  status       String   @default("OPEN") // OPEN | DISMISSED | ACTIONED
  createdAt    DateTime @default(now())

  @@unique([reviewId, reporterKey])
}

// Every email we try to send. With no provider configured this is the only record (admin can read links in dev).
model EmailOutbox {
  id          String    @id @default(cuid())
  to          String
  subject     String
  body        String
  purpose     String    @default("alerts") // which sender was used (see lib/mail.ts SENDERS)
  fromAddress String? // the address it was sent from, recorded so the outbox shows it
  replyTo     String?
  createdAt   DateTime  @default(now())
  sentAt      DateTime?
  error       String?

  @@index([purpose])
}

// Public "add a business" suggestions. Reviewed by an admin before becoming an UNCLAIMED Business.
model BusinessSubmission {
  id             String   @id @default(cuid())
  name           String
  category       String
  area           String
  address        String?
  postcode       String?
  phone          String?
  website        String?
  description    String
  submitterName  String
  submitterEmail String
  isOwner        Boolean  @default(false)
  status         String   @default("PENDING") // PENDING | APPROVED | REJECTED
  businessId     String?
  createdAt      DateTime @default(now())

  // ---- registration (decision D5). A submission from /register carries everything needed to create the
  // listing AND grant ownership in one approval, so there is only ever one queue and one approval screen.
  /// SUBMISSION (someone telling us about a business) | REGISTRATION (the owner signing their own up)
  kind            String    @default("SUBMISSION")
  /// The resolved place, from Ideal Postcodes plus postcodes.io. Matched on GSS codes, never on a name.
  placeId         String?
  place           Place?    @relation(fields: [placeId], references: [id], onDelete: SetNull)
  /// UDPRN of the address the person actually picked, so we know which building they chose.
  udprn           String?
  /// JSON string[] of Category ids: a business can offer more than one trade.
  categoryIds     String?
  /// JSON string[] of Place ids they will work in, with one mode for all of them.
  serviceAreaIds  String?
  serviceAreaMode String    @default("EXACT") // EXACT | INCLUDES_CHILDREN
  ownerRole       String?
  /// Email verification: the same bar claiming has to clear before anything is approved.
  emailTokenHash  String?   @unique
  emailVerifiedAt DateTime?
  /// Set when the business turned out to be listed already. The person is sent to claim it instead.
  duplicateOfId   String?
  reviewedBy      String?
  reviewNote      String?

  @@index([status])
  @@index([kind, status])
}

model AuditLog {
  id         String     @id @default(cuid())
  action     String
  targetType String
  targetId   String
  detail     String?
  /// Who did it. Null for system actions (the cron) and for pre-migration rows written when there was only
  /// one shared admin password and therefore no identity to record.
  actorId    String?
  actor      AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// The actor email as it was at the time, so the trail survives a rename or a deletion.
  actorEmail String?
  /// ADMIN | SUPER_ADMIN | AUTHOR | OWNER | SYSTEM
  actorKind  String?
  createdAt  DateTime   @default(now())

  @@index([actorId])
  @@index([createdAt])
}

// Per-page SEO controls, keyed by the page's canonical path (e.g. "/locations/hackney", "/locations/hackney/cleaning").
// robots: AUTO follows the quality gate; NOINDEX always hides; INDEX can only override the *thin-content* gate (never an empty page).
model SeoPage {
  id          String   @id @default(cuid())
  path        String   @unique
  title       String?
  description String?
  intro       String? // original editorial copy shown on the page; unlocks indexing for area/category pages
  robots      String   @default("AUTO") // AUTO | INDEX | NOINDEX
  updatedAt   DateTime @updatedAt
}

// Permanent redirects for moved/renamed URLs. Created automatically on slug changes, or by hand.
model Redirect {
  id        String    @id @default(cuid())
  fromPath  String    @unique
  toPath    String
  note      String?
  hits      Int       @default(0)
  lastHitAt DateTime?
  createdAt DateTime  @default(now())
}

// ---- Search -------------------------------------------------------------------------------------------------------
// One row per indexed thing. The full-text index itself is an FTS5 virtual table (search_fts) created by src/lib/search/fts.ts
// (Prisma can't manage virtual tables); its rowid = SearchDoc.rid. For PostgreSQL swap fts.ts for a tsvector implementation.
model SearchDoc {
  rid             Int      @id @default(autoincrement())
  kind            String // BUSINESS | ARTICLE | EPISODE
  refId           String
  visible         Boolean  @default(true) // published, not hidden
  liveFrom        DateTime @default(now()) // scheduled content becomes searchable at this time
  isSample        Boolean  @default(false)
  citySlug        String? // lets search be scoped to one city
  sourceUpdatedAt DateTime
  indexedAt       DateTime @default(now())

  @@unique([kind, refId])
  @@index([kind, visible])
}

// Aggregated, anonymous query log (no IPs, no user ids). Used for zero-result analysis and synonyms.
model SearchTerm {
  day       String
  q         String
  count     Int    @default(0)
  zeroCount Int    @default(0)

  @@id([day, q])
}

// ---- Newsletter ---------------------------------------------------------------------------------------------------
model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  status         String    @default("PENDING") // PENDING | ACTIVE | UNSUBSCRIBED
  confirmHash    String    @default("")
  unsubHash      String    @default("")
  interests      String? // JSON { areas: string[], categories: string[] }
  source         String?
  ipHash         String    @default("")
  createdAt      DateTime  @default(now())
  confirmedAt    DateTime?
  unsubscribedAt DateTime?

  @@index([status])
  @@index([confirmHash])
  @@index([unsubHash])
}

model NewsletterIssue {
  id         String    @id @default(cuid())
  subject    String
  body       String // plain text with {{unsubscribe}} placeholder
  sentAt     DateTime?
  recipients Int       @default(0)
  createdAt  DateTime  @default(now())
}

// ---- Commerce ------------------------------------------------------------------------------------------------------
// Principle: money buys visibility and tools, never trust. Paid placements are always labelled, organic ranking and reviews
// are never affected, and sample data can't be promoted.

// What can be bought. Prices are EDITABLE and start inactive — nothing is sold until an admin sets real prices and activates it.
model Product {
  id            String  @id @default(cuid())
  key           String  @unique // premium_monthly | premium_yearly | featured_30d | ...
  kind          String // PREMIUM | FEATURED
  name          String
  description   String
  pricePence    Int     @default(0) // ex VAT
  interval      String  @default("ONE_OFF") // MONTH | YEAR | ONE_OFF
  durationDays  Int? // FEATURED: how long the campaign runs
  stripePriceId String? // price id in Stripe (required for checkout)
  active        Boolean @default(false)
  sortOrder     Int     @default(0)
}

model Subscription {
  id                   String    @id @default(cuid())
  businessId           String
  business             Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productKey           String
  status               String    @default("ACTIVE") // ACTIVE | PAST_DUE | CANCELED
  provider             String    @default("STRIPE") // STRIPE | MANUAL (admin-granted / invoiced offline)
  stripeCustomerId     String?
  stripeSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  note                 String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now()) @updatedAt

  @@index([businessId, status])
}

model Order {
  id              String    @id @default(cuid())
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  ownerId         String?
  productKey      String
  amountPence     Int // gross, as charged — includes VAT when vatPence > 0
  /// The VAT portion of amountPence. Always 0 while VAT is switched off in Settings (the default, pending
  /// VAT registration). Snapshotted at the moment the order is created so a later rate change never rewrites history.
  vatPence        Int       @default(0)
  /// Basis points (2000 = 20%) in force when this order was created. 0 when VAT was off. Kept for audit even
  /// after the rate or the toggle changes.
  vatRateBp       Int       @default(0)
  /// CHECKOUT = the initial Stripe Checkout Session. RENEWAL = a later subscription billing cycle, recorded
  /// from `invoice.paid` so recurring revenue beyond the first period is not invisible to reporting. MANUAL =
  /// an admin-granted plan with no card payment.
  source          String    @default("CHECKOUT")
  status          String    @default("PENDING") // PENDING | PAID | FAILED | REFUNDED
  stripeSessionId String?   @unique
  createdAt       DateTime  @default(now())
  paidAt          DateTime?
}

/// A manually recorded operating cost. Phase 2 of the admin growth dashboard — see admin-dashboard-audit.md.
/// Separate from WriterPayment, which stays the editorial-freelancer ledger it already was.
model Expense {
  id          String   @id @default(cuid())
  /// HOSTING | MARKETING | SALES | CONTENT | CONTRACTORS | PAYMENT_FEES | OTHER
  category    String
  description String
  amountPence Int
  date        DateTime
  recurring   Boolean  @default(false)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([date])
  @@index([category])
}

// Idempotency for webhooks: a Stripe event id is processed at most once.
model StripeEvent {
  id        String   @id // evt_...
  type      String
  createdAt DateTime @default(now())
}

// Paid visibility. FEATURED = a business shown in a labelled slot on listing pages; AD = a direct-sold advertisement.
model Campaign {
  id            String         @id @default(cuid())
  kind          String // FEATURED | AD
  status        String         @default("ACTIVE") // ACTIVE | PAUSED | ENDED
  source        String         @default("MANUAL") // MANUAL | ORDER
  orderId       String?
  businessId    String? // FEATURED: which business
  business      Business?      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  advertiser    String? // AD: who is paying
  headline      String?
  body          String?
  imageUrl      String?
  linkUrl       String? // AD: https destination (we redirect by campaign id only, never from a URL parameter)
  placement     String         @default("LISTING") // LISTING | HOME | ARTICLE | PODCAST
  categoryId    String? // targeting (null = any)
  locationId    String?
  startsAt      DateTime       @default(now())
  endsAt        DateTime
  impressionCap Int?
  createdAt     DateTime       @default(now())
  stats         CampaignStat[]

  @@index([kind, status, endsAt])
}

model CampaignStat {
  campaignId  String
  day         String
  impressions Int      @default(0)
  clicks      Int      @default(0)
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@id([campaignId, day])
}

// Direct-sold sponsorship deals (podcast / newsletter / article / section): a ledger, plus the visible "Sponsored by" label.
model Sponsorship {
  id          String    @id @default(cuid())
  kind        String // ARTICLE | PODCAST | NEWSLETTER | OTHER
  sponsorName String
  website     String?
  pricePence  Int       @default(0)
  status      String    @default("DRAFT") // DRAFT | ACTIVE | DONE | CANCELLED
  startsAt    DateTime?
  endsAt      DateTime?
  episodeId   String?
  articleId   String?
  invoiced    Boolean   @default(false)
  notes       String?
  createdAt   DateTime  @default(now())
}

// Premium feature: enquiry form on the profile.
model Lead {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  email      String
  phone      String?
  message    String
  status     String   @default("NEW") // NEW | READ | ARCHIVED
  ipHash     String   @default("")
  createdAt  DateTime @default(now())

  @@index([businessId, status])
}

// Outbound interest signals (Premium analytics). One counter per business, kind and day.
model BusinessClick {
  businessId String
  kind       String // website | phone | directions
  day        String
  count      Int    @default(0)

  @@id([businessId, kind, day])
}

model SalesEnquiry {
  id         String   @id @default(cuid())
  name       String
  email      String
  company    String?
  interest   String // premium | featured | advertising | sponsorship | other
  message    String
  businessId String?
  status     String   @default("NEW") // NEW | CONTACTED | WON | LOST
  createdAt  DateTime @default(now())

  /// Phase 5 sales CRM: who owns this deal, when to follow up next, and when it left the pipeline
  /// (set alongside status moving to WON/LOST). All optional — no enquiry has ever had these recorded
  /// before Phase 5, and an enquiry can sit unassigned/un-followed-up indefinitely.
  assignedToId String?
  assignedTo   AdminUser? @relation(fields: [assignedToId], references: [id])
  followUpAt   DateTime?
  closedAt     DateTime?

  @@index([assignedToId])
}

// ============================================================================
// Operations, editorial accountability, writer management and owner tooling.
// Appended to schema.prisma by scripts/apply-additions.mjs.
// ============================================================================

/// One automated email rule. The programme in docs/lifecycle.md is defined in code; this row is the switch,
/// the record of what it has done, and the audit trail for turning it off.
model Automation {
  key          String          @id // matches a template id, e.g. "biz-claim-invite"
  enabled      Boolean         @default(false) // off until a human turns it on, so nothing surprises anyone
  lastRunAt    DateTime?
  lastSent     Int             @default(0)
  totalSent    Int             @default(0)
  totalSkipped Int             @default(0)
  lastError    String?
  dailyCap     Int             @default(50) // never send more than this in one run
  updatedAt    DateTime        @default(now()) @updatedAt
  runs         AutomationRun[]
}

model AutomationRun {
  id         String     @id @default(cuid())
  key        String
  automation Automation @relation(fields: [key], references: [key], onDelete: Cascade)
  sent       Int        @default(0)
  skipped    Int        @default(0)
  error      String?
  dryRun     Boolean    @default(false)
  startedAt  DateTime   @default(now())
  byAdmin    String?

  @@index([key, startedAt])
}

/// A published correction. Keeping these in public is the cheapest credibility a news title can buy.
model Correction {
  id          String   @id @default(cuid())
  articleId   String
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  summary     String // what was wrong, in plain words
  detail      String? // the fuller explanation, when one is warranted
  kind        String   @default("CORRECTION") // CORRECTION | CLARIFICATION | UPDATE
  isPublic    Boolean  @default(true)
  raisedBy    String? // who spotted it
  correctedBy String // which editor made the change
  createdAt   DateTime @default(now())

  @@index([articleId])
}

/// Work an editor has asked a writer to do.
model Commission {
  id             String    @id @default(cuid())
  authorId       String
  author         Author    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title          String
  brief          String
  type           String    @default("NEWS")
  feePence       Int? // agreed in writing before the work starts
  dueAt          DateTime?
  status         String    @default("OFFERED") // OFFERED | ACCEPTED | DECLINED | DELIVERED | CANCELLED
  articleId      String? // filled in once the writer starts the piece
  commissionedBy String
  respondedAt    DateTime?
  note           String? // the writer's reply when declining
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  @@index([authorId, status])
}

/// What a writer is owed and whether it has been paid.
model WriterPayment {
  id          String    @id @default(cuid())
  authorId    String
  author      Author    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  amountPence Int
  description String
  articleId   String?
  status      String    @default("DUE") // DUE | SUBMITTED | APPROVED | PAID
  reference   String? // the writer's own invoice number
  periodMonth String? // YYYY-MM
  approvedBy  String?
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([authorId, status])
}

/// In-app notifications, so a decision is not lost when an email is.
model Notification {
  id        String    @id @default(cuid())
  audience  String // AUTHOR | OWNER | ADMIN
  subjectId String // author id, owner id, or "admin"
  kind      String // DECISION | COMMISSION | ENQUIRY | REVIEW | PAYMENT | SYSTEM
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([audience, subjectId, readAt])
}

/// Per-article daily reads, so a writer can be told whether anyone read the piece.
model ArticleStat {
  articleId String
  day       String // YYYY-MM-DD
  views     Int     @default(0)
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([articleId, day])
  @@index([day])
}

/// Settings an admin can change without a deploy. Secrets stay in the environment.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt
  updatedBy String?
}

/// An invitation for a colleague to help manage a business listing.
model TeamInvite {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  email      String
  invitedBy  String
  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([businessId])
}

/// Holiday and one-off opening hours, which are the thing customers actually get wrong.
model SpecialHours {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  day        String // YYYY-MM-DD
  closed     Boolean  @default(false)
  opens      String? // HH:MM
  closes     String?
  note       String? // "Christmas Day", "Staff training"
  createdAt  DateTime @default(now())

  @@unique([businessId, day])
  @@index([businessId, day])
}

// ============================================================================
// England geography. One dataset behind business registration, service areas,
// customer job requests, lead matching, admin filtering and location pages.
//
// Built from ONS Open Geography Portal data (see docs/leadgen/geography/), never
// from recall. Additive: the existing City/Location tree stays in place and keeps
// serving live indexed URLs until a later, separately approved batch retires it.
// ============================================================================

/// A place: a country, an administrative tier, or a settlement. Flexible depth, because the number of
/// levels differs by nation and by place - a London address needs no county, a Berkshire one does.
model Place {
  id        String  @id @default(cuid())
  /// Natural key for idempotent import: "GSS:E09000002", "IPN:123456", "LEGACY:<Location id>".
  /// Re-running an import updates rather than duplicating.
  sourceKey String  @unique
  name      String
  slug      String
  /// COUNTRY | REGION | COUNTY | UNITARY | LAD | WARD | TOWN | SUBURB | LOCALITY
  kind      String
  parentId  String?
  parent    Place?  @relation("PlaceTree", fields: [parentId], references: [id])
  children  Place[] @relation("PlaceTree")

  /// ONS GSS code where the level has one. The canonical identifier - matching never uses names.
  gssCode    String?
  /// OS Open Names identifier, where the row came from the place index.
  osId       String?
  lat        Float?
  lng        Float?
  population Int?

  /// The shortest parent that makes this name unique ("Havering"), null when the name stands alone.
  disambiguation String?
  /// What a human should see: the name, or "name, disambiguation".
  label          String

  source        String // ONS_IPN_GB | ONS_WD26_LOOKUP | PRIMESTREET_EXISTING | MANUAL
  sourceDate    String // YYYY-MM-DD, when it was taken from that source
  confidence    String  @default("MEDIUM") // HIGH | MEDIUM | LOW
  evidenceNotes String?

  /// Can work genuinely be delivered here? Separate from whether the place exists.
  serviceable   Boolean @default(true)
  /// YES | NO | UNREVIEWED - whether a distinct landing page is justified, with the reason below.
  pageJustified String  @default("UNREVIEWED")
  decisionNotes String?
  active        Boolean @default(true)

  /// The Location row this replaces, so the migration is reversible and auditable.
  legacyLocationId String? @unique
  /// JSON array of the source keys merged into this row - boundary-straddling duplicates and
  /// the same place recorded at two geography levels.
  mergedFrom       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  aliases             PlaceAlias[]
  linksFrom           PlaceLink[]           @relation("PlaceLinkFrom")
  linksTo             PlaceLink[]           @relation("PlaceLinkTo")
  businesses          Business[]
  serviceAreas        BusinessServiceArea[]
  businessSubmissions BusinessSubmission[]

  @@unique([parentId, slug])
  @@index([kind])
  @@index([name])
  @@index([gssCode])
  @@index([parentId])
}

/// Alternative names, spellings and local names the official index does not recognise - Dagenham Dock
/// and Beam Park are real to the people who live there. Each carries its own source: an alias is never
/// invented, and never silently promoted to the status of an ONS locality.
model PlaceAlias {
  id         String   @id @default(cuid())
  placeId    String
  place      Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  alias      String
  normalised String // lowercased, punctuation stripped - what lookups actually match on
  /// SPELLING | FORMER_NAME | COLLOQUIAL | LOCAL_NAME | ABBREVIATION
  kind       String   @default("COLLOQUIAL")
  source     String
  sourceDate String
  createdAt  DateTime @default(now())

  @@unique([placeId, alias])
  @@index([normalised])
}

/// Relationships the single-parent tree cannot express. The locality Rush Green is in Havering, while
/// Barking and Dagenham has a ward called "Eastbrook & Rush Green": one name, two authorities, two
/// different senses. A tree forces a false choice; this records the association instead.
model PlaceLink {
  id        String   @id @default(cuid())
  fromId    String
  from      Place    @relation("PlaceLinkFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        Place    @relation("PlaceLinkTo", fields: [toId], references: [id], onDelete: Cascade)
  /// ALSO_ASSOCIATED_WITH | ADJACENT_TO | POSTAL_TOWN_OF | SAME_PLACE_OTHER_LEVEL
  relation  String
  note      String?
  createdAt DateTime @default(now())

  @@unique([fromId, toId, relation])
  @@index([toId])
}

/// Where a business is willing to work. Replaces the free-text Business.areasServed, which could not be
/// matched against anything. INCLUDES_CHILDREN on a borough says "all of it" once rather than fifteen times,
/// and the resolved scope is shown to the business and the administrator so nobody is guessing.
model BusinessServiceArea {
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  placeId    String
  place      Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  /// EXACT = this place only. INCLUDES_CHILDREN = this place and everything beneath it in the tree.
  mode       String   @default("EXACT")
  createdAt  DateTime @default(now())

  @@id([businessId, placeId])
  @@index([placeId])
}

/// A business can offer more than one service. Business.categoryId stays as the primary for now, because
/// directory URLs are built from it; isPrimary here is the same fact, ready for when it moves.
model BusinessCategory {
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@id([businessId, categoryId])
  @@index([categoryId])
}

/// The words customers actually use. Somebody searching for a "painter" means painting and decorating, and
/// a lead must reach the right trade rather than the nearest business. Each alias records where it came from.
model CategoryAlias {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  alias      String
  normalised String
  source     String   @default("MANUAL")
  createdAt  DateTime @default(now())

  @@unique([categoryId, alias])
  @@index([normalised])
}

/// One paid address lookup. Kept so the bill is predictable and attributable rather than discovered at the
/// end of the month, and so a per-session cap can be enforced. No address data is retained here: PAF is
/// licensed, and only the address a user actually selects is stored, against their own record.
model AddressLookup {
  id        String   @id @default(cuid())
  postcode  String
  results   Int      @default(0)
  provider  String   @default("IDEAL_POSTCODES")
  /// true when served without a paid call: a free test postcode, an invalid shape, or a refusal
  free      Boolean  @default(false)
  ipHash    String   @default("")
  ok        Boolean  @default(true)
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([ipHash, createdAt])
}

/// An individual administrator. Replaces the single shared ADMIN_PASSWORD so that a role can be attached to
/// a person and an audit entry can name who did it — which matters for a system that shares members of the
/// public's phone numbers with businesses and moves money between accounts.
model AdminUser {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String
  /// SUPER_ADMIN | ADMIN — see lib/admin-users.ts for what each may do.
  role         String  @default("ADMIN")
  /// scrypt, via lib/author-password.ts. Null until the account is set up from its one-time link.
  passwordHash String?
  active       Boolean @default(true)

  /// Phase 5 sales CRM: deals assigned to this admin as the sales owner.
  assignedEnquiries SalesEnquiry[]

  /// One-time setup or reset link. Hash only; the token itself is shown once and never stored.
  setupTokenHash String?   @unique
  setupExpiresAt DateTime?

  /// TOTP second factor, opt-in. The secret is encrypted at rest (lib/secretbox.ts), never stored plainly.
  totpSecretEnc      String?
  totpConfirmedAt    DateTime?
  /// Hashed single-use recovery codes, so losing a phone is not losing the account.
  recoveryCodeHashes String?

  /// Bumping this invalidates every existing session for this admin.
  sessionVersion Int       @default(1)
  lastLoginAt    DateTime?
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  auditEvents AuditLog[]

  @@index([active])
}

/// Login attempts, kept in the database rather than in memory so throttling survives a deploy and so there
/// is a trail if someone is probing the admin door. No password or password hash is ever recorded here.
model AdminLoginAttempt {
  id        String   @id @default(cuid())
  emailHash String // sha256 of the lowercased email: enough to throttle per account without storing it
  ipHash    String
  ok        Boolean  @default(false)
  reason    String?
  createdAt DateTime @default(now())

  @@index([emailHash, createdAt])
  @@index([ipHash, createdAt])
}

/// A business's lead-credit balance. `balance` is a cached sum of the ledger below, never the source of
/// truth, so any figure can be recomputed and any dispute answered from the transactions.
model CreditAccount {
  id           String    @id @default(cuid())
  businessId   String    @unique
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  balance      Int       @default(0)
  /// Non-null means the once-only welcome grant has happened. This is the guard that stops it being farmed
  /// by re-registering or editing a profile.
  freeGrantAt  DateTime?
  lowWarnedAt  DateTime?
  zeroWarnedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  transactions CreditTransaction[]
}

/// Every credit movement, with its reason and the balance it produced. A ledger, not a mutable number:
/// losing the audit trail on something that is money in all but name is not a trade worth making.
model CreditTransaction {
  id           String        @id @default(cuid())
  accountId    String
  account      CreditAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  businessId   String // denormalised so a business's history is one indexed read
  /// Signed: +5 for the welcome grant, -1 for a lead, +1 for a reversal.
  delta        Int
  balanceAfter Int
  /// FREE_GRANT | PURCHASE | CONSUMPTION | REFUND | ADJUSTMENT | REVERSAL
  kind         String
  reason       String
  /// What caused it, where there is something to point at.
  assignmentId String?
  orderId      String?
  /// Which administrator, for an ADJUSTMENT. Never null for one.
  adminId      String?
  createdAt    DateTime      @default(now())

  @@index([businessId, createdAt])
  @@index([kind])
}
